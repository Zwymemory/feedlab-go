:80 {
	root * /srv
	encode gzip zstd

	route {
		handle /api/* {
			reverse_proxy feedlab-api:8080
		}

		handle /healthz {
			reverse_proxy feedlab-api:8080
		}

		handle /swagger* {
			reverse_proxy feedlab-api:8080
		}

		handle /uploads/* {
			reverse_proxy feedlab-api:8080
		}

		handle {
			try_files {path} /index.html
			file_server
		}
	}
}
